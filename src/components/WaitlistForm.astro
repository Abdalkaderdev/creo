---
interface Props {
  variant?: "dark" | "light";
}
const { variant = "dark" } = Astro.props;
const wrap =
  variant === "dark"
    ? "bg-white/95 ring-1 ring-white/10"
    : "bg-white ring-1 ring-black/5";
---

<form
  class={`mx-auto flex w-full max-w-md items-center gap-1 rounded-full p-1.5 shadow-[0_10px_40px_-12px_rgba(124,92,255,0.45)] ${wrap}`}
  data-creo-waitlist
>
  <label for="email" class="sr-only">Email address</label>
  <input
    id="email"
    name="email"
    type="email"
    required
    autocomplete="email"
    placeholder="Enter your email address"
    class="flex-1 bg-transparent px-4 py-2 text-sm text-neutral-800 placeholder:text-neutral-400 outline-none"
  />
  <button
    type="submit"
    class="inline-flex items-center gap-1.5 rounded-full bg-creo-purple px-4 py-2 text-sm font-medium text-white transition hover:bg-creo-purple-bright"
  >
    Get Early Access
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-creo-waitlist]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") || "");
      // TODO: replace with real waitlist endpoint (Resend / Loops / ConvertKit / custom)
      console.log("waitlist signup:", email);
      form.reset();
      const btn = form.querySelector("button");
      if (btn) {
        const original = btn.innerHTML;
        btn.textContent = "You're on the list ✓";
        setTimeout(() => (btn.innerHTML = original), 2400);
      }
    });
  });
</script>
