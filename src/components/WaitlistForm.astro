---
interface Props {
  variant?: "dark" | "light";
}
const { variant = "dark" } = Astro.props;

const wrap =
  variant === "dark"
    ? "bg-white/[0.04] ring-1 ring-white/15 backdrop-blur-xl shadow-[0_8px_32px_-8px_rgba(0,0,0,0.5)]"
    : "bg-white/[0.08] ring-1 ring-white/25 backdrop-blur-xl shadow-[0_8px_32px_-8px_rgba(0,0,0,0.25)]";

const inputColor =
  variant === "dark"
    ? "text-white placeholder:text-white/70"
    : "text-white placeholder:text-white/75";
---

<form
  class="mx-auto w-full max-w-md"
  data-creo-waitlist
  novalidate
>
  <label for="creo-email" class="sr-only">Email address</label>
  <div class={`flex items-center gap-1 rounded-full p-1.5 transition ${wrap}`} data-creo-pill>
    <input
      id="creo-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="Enter your email address"
      aria-describedby="creo-email-msg"
      class={`flex-1 min-w-0 bg-transparent px-4 py-2.5 text-base outline-none ${inputColor}`}
    />
    <button
      type="submit"
      class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white px-4 py-2.5 text-sm font-semibold text-creo-purple transition hover:bg-white/90"
    >
      <span data-btn-label>Get Early Access</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
  <p
    id="creo-email-msg"
    class="mt-3 min-h-[1.25rem] text-center text-sm"
    aria-live="polite"
    data-creo-msg
  ></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-creo-waitlist]").forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const pill = form.querySelector<HTMLElement>("[data-creo-pill]")!;
    const msg = form.querySelector<HTMLElement>("[data-creo-msg]")!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const btnLabel = btn.querySelector<HTMLElement>("[data-btn-label]")!;
    const label = btnLabel.textContent ?? "";

    function showError(text: string) {
      msg.textContent = text;
      msg.style.color = "#fca5a5";
      input.setAttribute("aria-invalid", "true");
      pill.style.boxShadow = "0 0 0 1px #fca5a5";
    }
    function clearState() {
      msg.textContent = "";
      input.removeAttribute("aria-invalid");
      pill.style.boxShadow = "";
    }
    function showSuccess() {
      msg.textContent = "You're on the list — we'll be in touch soon.";
      msg.style.color = "#86efac";
      btnLabel.textContent = "Joined ✓";
    }

    input.addEventListener("input", clearState);

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (!value) {
        showError("Please enter your email.");
        input.focus();
        return;
      }
      if (!input.checkValidity()) {
        showError("That email doesn't look right.");
        input.focus();
        return;
      }
      // TODO: replace with real waitlist endpoint (Resend / Loops / ConvertKit / custom)
      console.log("waitlist signup:", value);
      showSuccess();
      btn.disabled = true;
      setTimeout(() => {
        btnLabel.textContent = label;
        btn.disabled = false;
      }, 4000);
      form.reset();
    });
  });
</script>
