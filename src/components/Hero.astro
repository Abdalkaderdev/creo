---
import { Icon } from "astro-icon/components";
import WaitlistForm from "./WaitlistForm.astro";
---

<section class="relative overflow-hidden bg-creo-bg pb-24 pt-20 sm:pt-24">
  <div class="absolute inset-0 -z-0 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[520px] w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.35),transparent_70%)] blur-2xl"></div>
    <div class="absolute inset-x-0 bottom-[34%] sm:bottom-0">
      <div class="relative">
        <video
          id="hero-video"
          class="block w-full select-none object-cover opacity-95"
          muted
          loop
          playsinline
          preload="metadata"
          poster="/hero-wave.png"
        >
          <source src="/videos/hero-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
          <source src="/videos/hero-720.mp4" type="video/mp4" media="(max-width: 1280px)" />
          <source src="/videos/hero-1080.mp4" type="video/mp4" />
        </video>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-creo-bg sm:hidden"></div>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-creo-bg to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-creo-bg"></div>
  </div>

  <script is:inline>
    (() => {
      const v = document.getElementById("hero-video");
      if (!v) return;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      v.currentTime = 0;
      if (!reduced) v.play().catch(() => {});
      window.addEventListener("pageshow", () => {
        v.currentTime = 0;
        if (!reduced) v.play().catch(() => {});
      });
    })();
  </script>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl pt-12 text-center sm:pt-16">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/80 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_10px_2px_rgba(52,211,153,0.7)]"></span>
        Now Accepting Early Access
      </span>

      <h1 class="mt-6 text-4xl font-black leading-none tracking-tight sm:text-6xl md:text-[70px]">
        Create Anything.<br />
        <span class="font-serif font-normal text-creo-purple-bright">Organize Everything.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg font-medium leading-relaxed text-white sm:text-xl">
        Creo is the creative platform that brings AI generation, asset
        management, and team collaboration into one focused workflow.
      </p>

      <div class="mt-8">
        <WaitlistForm shape="rect" />
      </div>
    </div>

    <dl class="mx-auto mt-14 grid max-w-3xl grid-cols-2 items-start gap-x-4 gap-y-8 sm:mt-20 sm:gap-y-10 sm:grid-cols-4">
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          4<span class="text-creo-purple-bright">K</span>
        </dt>
        <dd class="mt-3 text-sm font-medium leading-tight" style="color:#6D6D96">Image<br />Output</dd>
      </div>
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          1080<span class="text-creo-purple-bright">P</span>
        </dt>
        <dd class="mt-3 text-sm font-medium leading-tight" style="color:#6D6D96">Video<br />Output</dd>
      </div>
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          6<span class="text-creo-purple-bright">+</span>
        </dt>
        <dd class="mt-3 text-sm font-medium leading-tight" style="color:#6D6D96">Best-In-Class<br />AI Models</dd>
      </div>
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          500<span class="text-creo-purple-bright">GB</span>
        </dt>
        <dd class="mt-3 inline-flex items-center justify-center gap-1.5 text-sm font-medium leading-tight" style="color:#6D6D96">
          <span>Cloud<br />Storage</span>
          <span class="group relative inline-flex self-start">
            <button
              type="button"
              class="inline-flex"
              aria-label="More info about cloud storage"
              style="color:#6D6D96"
            >
              <Icon name="lucide:info" class="h-3.5 w-3.5" />
            </button>
            <span
              role="tooltip"
              class="pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 w-56 -translate-x-1/2 rounded-lg bg-creo-bg/95 px-3 py-2 text-[11px] font-normal text-white opacity-0 ring-1 ring-white/15 backdrop-blur-md transition group-hover:opacity-100 group-focus-within:opacity-100"
            >
              Up to 500GB on our Studio plan. Storage varies based on plan.
            </span>
          </span>
        </dd>
      </div>
    </dl>
  </div>
</section>
