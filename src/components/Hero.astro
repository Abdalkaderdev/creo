---
import Logo from "./Logo.astro";
import WaitlistForm from "./WaitlistForm.astro";

const stats = [
  { value: "4K", suffix: "", label: "Image\nOutput", accent: "K" },
  { value: "1080P", suffix: "", label: "Video\nOutput" },
  { value: "6+", suffix: "", label: "Best-In-Class\nAI Models" },
  { value: "500", suffix: "GB", label: "Cloud\nStorage" },
];
---

<section class="relative overflow-hidden bg-creo-bg pb-24 pt-8">
  <div class="absolute inset-0 -z-0" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[520px] w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.35),transparent_70%)] blur-2xl"></div>
    <img
      src="/hero-wave.png"
      alt=""
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 w-full select-none object-cover opacity-95"
    />
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-creo-bg"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <header class="flex items-center justify-between py-2">
      <Logo />
    </header>

    <div class="mx-auto max-w-3xl pt-20 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/80 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_10px_2px_rgba(52,211,153,0.7)]"></span>
        Now Accepting Early Access
      </span>

      <h1 class="mt-6 text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
        Create Anything.<br />
        <span class="font-serif italic text-creo-purple-bright">Organize Everything.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-creo-muted">
        Creo is the creative platform that brings AI generation, asset
        management, and team collaboration into one focused workflow.
      </p>

      <div class="mt-8">
        <WaitlistForm />
      </div>
    </div>

    <dl class="mx-auto mt-20 grid max-w-3xl grid-cols-2 gap-y-10 sm:grid-cols-4">
      <div class="text-center">
        <dt class="text-5xl font-semibold tracking-tight sm:text-6xl">
          4<span class="text-creo-purple-bright">K</span>
        </dt>
        <dd class="mt-2 text-xs uppercase tracking-wider text-creo-muted">Image<br />Output</dd>
      </div>
      <div class="text-center">
        <dt class="text-5xl font-semibold tracking-tight sm:text-6xl">
          1080<span class="text-creo-purple-bright">P</span>
        </dt>
        <dd class="mt-2 text-xs uppercase tracking-wider text-creo-muted">Video<br />Output</dd>
      </div>
      <div class="text-center">
        <dt class="text-5xl font-semibold tracking-tight sm:text-6xl">
          6<span class="text-creo-purple-bright">+</span>
        </dt>
        <dd class="mt-2 text-xs uppercase tracking-wider text-creo-muted">Best-In-Class<br />AI Models</dd>
      </div>
      <div class="text-center">
        <dt class="text-5xl font-semibold tracking-tight sm:text-6xl">
          500<span class="text-creo-purple-bright">GB</span>
        </dt>
        <dd class="mt-2 text-xs uppercase tracking-wider text-creo-muted">Cloud<br />Storage<sup class="text-[0.6em]">©</sup></dd>
      </div>
    </dl>
  </div>
</section>
