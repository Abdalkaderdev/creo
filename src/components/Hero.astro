---
import WaitlistForm from "./WaitlistForm.astro";
---

<section class="relative min-h-screen overflow-hidden bg-creo-bg pb-24 pt-20 sm:pt-24">
  <div class="absolute inset-0 -z-0 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[360px] w-[700px] sm:h-[520px] sm:w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(124,92,255,0.22),transparent_70%)] sm:bg-[radial-gradient(closest-side,rgba(124,92,255,0.35),transparent_70%)] blur-2xl"></div>
    <div class="absolute inset-x-0 bottom-[34%] sm:bottom-0">
      <div class="relative bg-creo-bg">
        <video
          id="hero-video"
          class="block w-full select-none object-cover opacity-95"
          muted
          loop
          playsinline
          preload="metadata"
          poster="/hero-wave.png"
        >
          <source src="/videos/hero-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
          <source src="/videos/hero-720.mp4" type="video/mp4" media="(max-width: 1280px)" />
          <source src="/videos/hero-1080.mp4" type="video/mp4" />
        </video>
        <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-creo-bg to-transparent sm:hidden"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-creo-bg sm:hidden"></div>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-creo-bg via-creo-bg/95 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-creo-bg"></div>
  </div>

  <script is:inline>
    (() => {
      const v = document.getElementById("hero-video");
      if (!v) return;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      v.currentTime = 0;
      if (!reduced) v.play().catch(() => {});
      window.addEventListener("pageshow", () => {
        v.currentTime = 0;
        if (!reduced) v.play().catch(() => {});
      });
    })();

  </script>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl pt-12 text-center sm:pt-16">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/80 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_10px_2px_rgba(52,211,153,0.7)]"></span>
        Now Accepting Early Access
      </span>

      <h1 class="mt-6 text-4xl font-black leading-none tracking-tight sm:text-6xl md:text-[70px]">
        Create Anything.<br />
        <span class="whitespace-nowrap font-serif font-normal text-[clamp(22px,7.5vw,32px)] text-creo-purple-bright sm:text-6xl md:text-[70px]">Orchestrate Everything.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-base font-medium leading-relaxed text-white sm:text-xl">
        Creo connects AI-powered creation, asset management, and team<br class="hidden sm:inline" /> collaboration into one easy-to-use system.
      </p>

      <div class="mt-8">
        <WaitlistForm shape="rect" />
      </div>
    </div>

    <dl class="mx-auto mt-14 grid max-w-3xl grid-cols-2 items-start gap-x-4 gap-y-8 sm:mt-20 sm:gap-y-10 sm:grid-cols-4">
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          4<span class="text-creo-purple-bright">K</span>
        </dt>
        <dd class="mt-1 text-base font-medium leading-tight sm:mt-2 sm:text-base" style="color:#6D6D96">Image<br />Output</dd>
      </div>
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          1080<span class="text-creo-purple-bright">P</span>
        </dt>
        <dd class="mt-1 text-base font-medium leading-tight sm:mt-2 sm:text-base" style="color:#6D6D96">Video<br />Output</dd>
      </div>
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          6<span class="text-creo-purple-bright">+</span>
        </dt>
        <dd class="mt-1 text-base font-medium leading-tight sm:mt-2 sm:text-base" style="color:#6D6D96">Best-In-Class<br />AI Models</dd>
      </div>
      <div class="text-center">
        <dt class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          500<span class="text-creo-purple-bright">GB</span>
        </dt>
        <dd class="mt-1 text-base font-medium leading-tight sm:mt-2 sm:text-base" style="color:#6D6D96">Cloud<br />Storage</dd>
      </div>
    </dl>
  </div>
</section>
