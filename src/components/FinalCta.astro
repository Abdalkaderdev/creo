---
import Logo from "./Logo.astro";
import WaitlistForm from "./WaitlistForm.astro";
---

<section class="bg-creo-purple-band py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
      Be first to create with Creo
    </h2>
    <p class="mx-auto mt-4 max-w-md text-base text-white/85">
      Join the waitlist and get early access before public launch.
    </p>
    <div class="mt-8">
      <WaitlistForm />
    </div>
  </div>
</section>

<footer class="bg-creo-bg py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-xs text-creo-muted sm:flex-row">
    <Logo />
    <p>Copyright © 2026 Creo Labs, LLC. All rights reserved.</p>
    <nav class="flex items-center gap-6">
      <a href="/privacy" class="hover:text-white">Privacy Policy</a>
      <a href="/terms" class="hover:text-white">Terms of Service</a>
      <a href="/cookies" class="hover:text-white">Cookies Settings</a>
    </nav>
  </div>
</footer>
