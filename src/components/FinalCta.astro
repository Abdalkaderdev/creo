---
import WaitlistForm from "./WaitlistForm.astro";
---

<section id="waitlist" class="bg-[linear-gradient(180deg,#4B308F_0%,#8052F5_100%)] py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl font-black leading-none tracking-tight text-white sm:text-5xl">
      Be first to create with Creo<span class="text-creo-purple-bright">.</span>
    </h2>
    <p class="mx-auto mt-4 max-w-md text-sm text-white/85 sm:text-base">
      Join the waitlist and get early access before public launch.
    </p>
    <div class="mt-8">
      <WaitlistForm variant="light" />
    </div>
  </div>
</section>

<footer class="bg-creo-bg py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-xs text-creo-muted sm:flex-row">
    <img src="/creo-logo.svg" alt="Creo" class="h-6 w-auto" />
    <p class="text-center sm:text-left">Copyright © 2026 Creo Labs, LLC. All rights reserved.</p>
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a href="/privacy" class="hover:text-white">Privacy Policy</a>
      <a href="/terms" class="hover:text-white">Terms of Service</a>
      <a href="/cookies" class="hover:text-white">Cookies Settings</a>
    </nav>
  </div>
</footer>
