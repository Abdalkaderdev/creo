---
import WaitlistForm from "./WaitlistForm.astro";
---

<section id="waitlist" class="bg-[#5A3CC8] py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl font-black leading-none tracking-tight text-white sm:text-5xl">
      Be First to Create<br class="sm:hidden" /> with Creo<span class="text-creo-purple-bright">.</span>
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base font-medium text-white sm:whitespace-nowrap sm:text-lg">
      Join the waitlist and get early access before public launch.
    </p>
    <div class="mt-8">
      <WaitlistForm variant="light" shape="rect" />
    </div>
  </div>
</section>

<footer class="bg-creo-bg py-16 sm:py-20">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-6 text-sm sm:flex-row"
    style="color:#6D6D96"
  >
    <img src="/creo-logo.svg" alt="Creo" class="h-12 w-auto sm:h-14" />
    <p class="text-center sm:text-left">Copyright © 2026 Creo Labs, LLC. All rights reserved.</p>
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <a href="/privacy" class="hover:text-white">Privacy Policy</a>
      <a href="/terms" class="hover:text-white">Terms of Service</a>
      <a href="/cookies" class="hover:text-white">Cookies Settings</a>
    </nav>
  </div>
</footer>
