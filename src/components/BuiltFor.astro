---
import BuiltForCard from "./BuiltForCard.astro";

type Tone = "lavender" | "white" | "dark" | "purple-gradient";

const features: Array<{
  title: string;
  body: string;
  poster?: string;
  video?: string;
  tone: Tone;
  alt: string;
  mediaPosition?: string;
}> = [
  {
    title: "Character\nCreation",
    body: "Design consistent, original characters across styles and formats — from brand mascots to campaign protagonists — without a single illustration brief.",
    poster: "/posters/character-creation.png",
    tone: "lavender",
    alt: "Character creation example",
    mediaPosition: "center top",
  },
  {
    title: "Product\nIntegrations",
    body: "Place your products into any scene, environment, or context. Photorealistic compositing at the speed of a prompt.",
    poster: "/posters/product-integrations.png",
    tone: "white",
    alt: "Product integration example",
    mediaPosition: "center top",
  },
  {
    title: "Cinematic\nContent",
    body: "Studio-quality visuals without the studio. Generate photorealistic, film-grade imagery and footage that elevates every piece of content you put out.",
    poster: "/posters/cinematic-content.png",
    video: "/videos/t-rex.mp4?v=3",
    tone: "dark",
    alt: "Cinematic content example",
    mediaPosition: "center top",
  },
  {
    title: "User Generated\nContent",
    body: "Produce authentic-feeling user-generated content at scale. The raw, relatable aesthetic — without the casting call.",
    poster: "/posters/user-generated-content.png",
    video: "/videos/sophia-ugc.mp4?v=3",
    tone: "lavender",
    alt: "UGC example",
    mediaPosition: "center top",
  },
  {
    title: "B-Roll\nCreation",
    body: "Generate cinematic supplemental footage that matches your hero content. Fill every cut without a second shoot day.",
    poster: "/posters/b-roll.png",
    video: "/videos/b-roll.mp4",
    tone: "white",
    alt: "B-roll footage example",
  },
  {
    title: "Motion Graphics\n& Animation",
    body: "Bring static assets to life. Titles, transitions, loops, and animated brand elements — all inside your existing project workspace.",
    poster: "/posters/motion-graphics.png",
    tone: "dark",
    alt: "Motion graphics example",
  },
  {
    title: "Illustration\n& Infographics",
    body: "Original illustrated assets in any style — editorial, flat, painterly, technical. Consistent enough to build a visual system around.",
    poster: "/posters/illustration-infographics.png",
    tone: "lavender",
    alt: "Illustration example",
  },
  {
    title: "Social Media\nTrends & Formats",
    body: "Generate native-sized assets for every platform in one session. Reels, Stories, carousels, thumbnails — all from a single creative direction.",
    poster: "/posters/social-media-trends.png",
    tone: "white",
    alt: "Social media trends example",
    mediaPosition: "center top",
  },
  {
    title: "Asset Library\nExtensions",
    body: "Expand your existing brand library without starting from scratch. Generate on-brand variations that slot directly into your established system.",
    poster: "/posters/asset-library-extensions.png",
    tone: "dark",
    alt: "Asset library example",
  },
];
---

<section class="relative bg-[linear-gradient(180deg,#4B308F_0%,#8052F5_100%)]">
  {/* MOBILE: vertical heading + horizontal touch carousel */}
  <div class="md:hidden py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center">
        <h2 class="text-4xl font-black leading-none tracking-tight text-white">
          Built For The Things You Make<span class="text-creo-purple-bright">.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-md text-sm font-medium text-white">
          Whether you're running solo campaigns or managing a full production team,
          Creo fits the workflow.
        </p>
      </div>
      <div
        class="-mx-6 mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pr-6 pb-28 pt-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [scroll-padding-left:1.5rem]"
      >
        <div class="shrink-0 w-6" aria-hidden="true"></div>
        {features.map((f, i) => <BuiltForCard {...f} eager={i === 0} />)}
        <div class="shrink-0 w-px" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  {/* DESKTOP: heading + horizontally-scrollable carousel with visible scrollbar and prev/next buttons */}
  <div class="hidden md:block py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div class="flex items-end justify-between gap-6">
        <div class="max-w-3xl">
          <h2 class="text-5xl font-black leading-none tracking-tight text-white sm:text-6xl lg:text-[5.5rem]">
            Built For The Things You Make<span class="text-creo-purple-bright">.</span>
          </h2>
          <p class="mt-6 max-w-2xl text-lg font-medium text-white">
            Whether you're running solo campaigns or managing a full production team,
            Creo fits the workflow.
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-3">
          <button
            type="button"
            data-builtfor-prev
            aria-label="Previous card"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/20 backdrop-blur transition hover:bg-white/20 disabled:cursor-not-allowed disabled:opacity-40"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button
            type="button"
            data-builtfor-next
            aria-label="Next card"
            class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/20 backdrop-blur transition hover:bg-white/20 disabled:cursor-not-allowed disabled:opacity-40"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div
      data-builtfor-track
      class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-6 pb-6 [scrollbar-color:rgba(255,255,255,0.45)_rgba(255,255,255,0.12)] [scrollbar-width:thin] [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:rounded-full [&::-webkit-scrollbar-track]:bg-white/10 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-white/40 hover:[&::-webkit-scrollbar-thumb]:bg-white/60"
    >
      {features.map((f, i) => <BuiltForCard {...f} eager={i === 0} />)}
      <div class="shrink-0 w-6" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  // ---- Hover-to-play (one video at a time; try unmuted then fall back to muted) ----
  type CardCtl = { video: HTMLVideoElement };
  const controllers: CardCtl[] = [];

  // Browsers only allow unmuted playback after a user gesture. We listen broadly
  // (including scroll wheel + touch) so by the time the user reaches the carousel,
  // audio is already unlocked.
  let audioUnlocked = false;
  const unlock = () => {
    audioUnlocked = true;
    document.removeEventListener("pointerdown", unlock);
    document.removeEventListener("keydown", unlock);
    document.removeEventListener("touchstart", unlock);
    document.removeEventListener("wheel", unlock);
    document.removeEventListener("scroll", unlock);
  };
  document.addEventListener("pointerdown", unlock, { passive: true });
  document.addEventListener("keydown", unlock);
  document.addEventListener("touchstart", unlock, { passive: true });
  document.addEventListener("wheel", unlock, { passive: true });
  document.addEventListener("scroll", unlock, { passive: true });

  document.querySelectorAll<HTMLElement>("[data-builtfor-card]").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("[data-card-video]");
    if (!video) return;
    const overlay = card.querySelector<HTMLElement>("[data-card-play-overlay]");
    const ctl: CardCtl = { video };
    controllers.push(ctl);

    const hideOverlay = () => { if (overlay) overlay.style.opacity = "0"; };
    const showOverlay = () => { if (overlay) overlay.style.opacity = "1"; };

    const startPlay = async () => {
      controllers.forEach((other) => {
        if (other.video !== video && !other.video.paused) {
          other.video.pause();
          other.video.currentTime = 0;
          other.video.style.opacity = "0";
          const otherOverlay = other.video.parentElement?.querySelector<HTMLElement>("[data-card-play-overlay]");
          if (otherOverlay) otherOverlay.style.opacity = "1";
        }
      });
      video.muted = !audioUnlocked;
      video.volume = 1;
      try {
        await video.play();
      } catch {
        // Browser blocked unmuted autoplay — fall back to muted so something still plays.
        video.muted = true;
        try { await video.play(); } catch {}
      }
      video.style.opacity = "1";
      hideOverlay();
    };
    const stopPlay = () => {
      video.pause();
      video.currentTime = 0;
      video.style.opacity = "0";
      showOverlay();
    };

    card.addEventListener("mouseenter", startPlay);
    card.addEventListener("mouseleave", stopPlay);
    card.addEventListener("focusin", startPlay);
    card.addEventListener("focusout", stopPlay);
    // Click guarantees user activation — unmute and restart with sound.
    card.addEventListener("click", () => {
      if (video.paused) {
        startPlay();
      } else if (video.muted) {
        video.muted = false;
        video.volume = 1;
      } else {
        stopPlay();
      }
    });
  });

  // ---- Desktop prev/next buttons drive the horizontal scroll container ----
  const track = document.querySelector<HTMLElement>("[data-builtfor-track]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-builtfor-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-builtfor-next]");

  function cardStep() {
    if (!track) return 0;
    const card = track.querySelector<HTMLElement>("[data-builtfor-card]");
    if (!card) return 0;
    const gap = parseFloat(getComputedStyle(track).columnGap || "24") || 24;
    return card.getBoundingClientRect().width + gap;
  }

  function updateButtons() {
    if (!track || !prevBtn || !nextBtn) return;
    const max = track.scrollWidth - track.clientWidth;
    prevBtn.disabled = track.scrollLeft <= 1;
    nextBtn.disabled = track.scrollLeft >= max - 1;
  }

  prevBtn?.addEventListener("click", () => {
    track?.scrollBy({ left: -cardStep(), behavior: "smooth" });
  });
  nextBtn?.addEventListener("click", () => {
    track?.scrollBy({ left: cardStep(), behavior: "smooth" });
  });

  track?.addEventListener("scroll", updateButtons, { passive: true });
  window.addEventListener("resize", updateButtons);
  updateButtons();
</script>
