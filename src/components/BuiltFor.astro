---
import Logo from "./Logo.astro";

function iconFor(name: string): string {
  const stroke =
    'stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"';
  const w = 'width="18" height="18" viewBox="0 0 24 24"';
  switch (name) {
    case "user-star":
      return `<svg ${w}><circle ${stroke} cx="12" cy="8" r="4"/><path ${stroke} d="M5 21a7 7 0 0 1 14 0"/><path ${stroke} d="M18 3l.8 1.6L20.5 5l-1.2 1.2.3 1.7L18 7.1 16.4 7.9l.3-1.7L15.5 5l1.7-.4Z"/></svg>`;
    case "cup":
      return `<svg ${w}><path ${stroke} d="M6 8h12l-1 11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2Z"/><path ${stroke} d="M9 8V5a3 3 0 0 1 6 0v3"/></svg>`;
    case "grid":
      return `<svg ${w}><rect ${stroke} x="3" y="3" width="7" height="7" rx="1.5"/><rect ${stroke} x="14" y="3" width="7" height="7" rx="1.5"/><rect ${stroke} x="3" y="14" width="7" height="7" rx="1.5"/><rect ${stroke} x="14" y="14" width="7" height="7" rx="1.5"/></svg>`;
    case "users":
      return `<svg ${w}><circle ${stroke} cx="9" cy="8" r="3.5"/><path ${stroke} d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path ${stroke} d="M16 4a3 3 0 0 1 0 6"/><path ${stroke} d="M18 14a5 5 0 0 1 4 5"/></svg>`;
    case "layers":
      return `<svg ${w}><path ${stroke} d="M12 3l9 5-9 5-9-5Z"/><path ${stroke} d="M3 13l9 5 9-5"/></svg>`;
    default:
      return "";
  }
}

type Tone = "lavender" | "white" | "dark";

const features: Array<{ icon: string; title: string; body: string; tone: Tone }> = [
  {
    icon: "user-star",
    title: "Character\nCreation",
    body: "Design consistent, original characters across styles and formats — from brand mascots to campaign protagonists — without a single illustration brief.",
    tone: "lavender",
  },
  {
    icon: "cup",
    title: "Product\nIntegration",
    body: "Place your products into any scene, environment, or context. Photorealistic compositing at the speed of a prompt.",
    tone: "white",
  },
  {
    icon: "grid",
    title: "Social Media\nFormats",
    body: "Generate native-sized assets for every platform in one session. Reels, Stories, carousels, thumbnails — all from a single creative direction.",
    tone: "dark",
  },
  {
    icon: "users",
    title: "UGC",
    body: "Produce authentic-feeling generated content — raw, relatable, and ready for the casting call.",
    tone: "lavender",
  },
  {
    icon: "layers",
    title: "Brand\nCampaigns",
    body: "Spin up cohesive multi-asset campaigns with shared style, palette, and tone — locked in from the first prompt.",
    tone: "lavender",
  },
];

const toneClass: Record<Tone, string> = {
  lavender: "bg-creo-card-lavender text-white",
  white: "bg-white text-creo-purple shadow-[0_30px_60px_-20px_rgba(0,0,0,0.45)]",
  dark: "bg-creo-card-dark text-white",
};

const iconColor: Record<Tone, string> = {
  lavender: "text-white",
  white: "text-creo-purple",
  dark: "text-white",
};

const titleColor: Record<Tone, string> = {
  lavender: "text-white",
  white: "text-creo-purple",
  dark: "text-white",
};

const bodyColor: Record<Tone, string> = {
  lavender: "text-white/90",
  white: "text-creo-purple",
  dark: "text-white/80",
};
---

<section class="relative overflow-hidden bg-creo-purple-band py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-center justify-between">
      <Logo variant="lavender" />
    </div>

    <div class="mt-20 text-center">
      <h2 class="mx-auto max-w-6xl text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-7xl md:text-[5.5rem]">
        Built For The Things You Make.
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-base text-white/85">
        Whether you're running solo campaigns or managing a full production team,
        Creo fits the workflow.
      </p>
    </div>

    <div class="relative mt-14">
      <div
        id="builtfor-track"
        class="flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {features.map((f) => (
          <article
            class:list={[
              "snap-start shrink-0 basis-[280px] sm:basis-[330px] rounded-2xl p-7 transition min-h-[400px] flex flex-col",
              toneClass[f.tone],
            ]}
          >
            <div
              class:list={["flex h-9 w-9 items-center justify-center", iconColor[f.tone]]}
              aria-hidden="true"
              set:html={iconFor(f.icon)}
            />
            <h3
              class:list={[
                "mt-8 whitespace-pre-line text-2xl font-bold leading-tight",
                titleColor[f.tone],
              ]}
            >
              {f.title}
            </h3>
            <p class:list={["mt-6 text-sm leading-relaxed", bodyColor[f.tone]]}>
              {f.body}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-10 flex items-center justify-center gap-3">
        <button
          type="button"
          aria-label="Previous"
          data-builtfor-prev
          class="grid h-10 w-10 place-items-center rounded-md border border-white/40 text-white transition hover:bg-white/10"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button
          type="button"
          aria-label="Next"
          data-builtfor-next
          class="grid h-10 w-10 place-items-center rounded-md border border-white/40 text-white transition hover:bg-white/10"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("builtfor-track");
  if (track) {
    const card = track.querySelector("article") as HTMLElement | null;
    const step = card ? card.offsetWidth + 20 : 300;
    document.querySelector("[data-builtfor-prev]")?.addEventListener("click", () =>
      track.scrollBy({ left: -step, behavior: "smooth" })
    );
    document.querySelector("[data-builtfor-next]")?.addEventListener("click", () =>
      track.scrollBy({ left: step, behavior: "smooth" })
    );
  }
</script>
