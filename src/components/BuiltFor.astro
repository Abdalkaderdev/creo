---
import BuiltForCard from "./BuiltForCard.astro";

type Tone = "lavender" | "white" | "dark" | "purple-gradient";

const features: Array<{
  title: string;
  body: string;
  poster?: string;
  video?: string;
  tone: Tone;
  alt: string;
}> = [
  {
    title: "Character\nCreation",
    body: "Design consistent, original characters across styles and formats — from brand mascots to campaign protagonists — without a single illustration brief.",
    poster: "/posters/character-creation.png",
    tone: "purple-gradient",
    alt: "Character creation example",
  },
  {
    title: "Product\nIntegrations",
    body: "Studio-quality visuals without the studio. Generate photorealistic, film-grade imagery and footage that elevates every piece of content you put out.",
    poster: "/posters/product-integrations.png",
    tone: "white",
    alt: "Product integration example",
  },
  {
    title: "Cinematic\nContent",
    body: "Studio-quality visuals without the studio. Generate photorealistic, film-grade imagery and footage that elevates every piece of content you put out.",
    poster: "/posters/cinematic-content.png",
    video: "/videos/t-rex.mp4",
    tone: "dark",
    alt: "Cinematic content example",
  },
  {
    title: "User Generated\nContent",
    body: "Produce authentic-feeling user-generated content at scale. The raw, relatable aesthetic — without the casting call.",
    poster: "/posters/user-generated-content.png",
    video: "/videos/sophia-ugc.mp4",
    tone: "lavender",
    alt: "UGC example",
  },
  {
    title: "B-Roll\nCreation",
    body: "Generate cinematic supplemental footage that matches your hero content. Fill every cut without a second shoot day.",
    poster: "/posters/b-roll.png",
    video: "/videos/b-roll.mp4",
    tone: "white",
    alt: "B-roll footage example",
  },
  {
    title: "Motion Graphics\n& Animation",
    body: "Bring static assets to life. Titles, transitions, loops, and animated brand elements — all inside your existing project workspace.",
    poster: "/posters/motion-graphics.png",
    tone: "dark",
    alt: "Motion graphics example",
  },
  {
    title: "Illustration\n& Infographics",
    body: "Original illustrated assets in any style — editorial, flat, painterly, technical. Consistent enough to build a visual system around.",
    poster: "/posters/illustration-infographics.png",
    tone: "lavender",
    alt: "Illustration example",
  },
  {
    title: "Social Media\nTrends & Formats",
    body: "Generate native-sized assets for every platform in one session. Reels, Stories, carousels, thumbnails — all from a single creative direction.",
    poster: "/posters/social-media-trends.png",
    tone: "white",
    alt: "Social media trends example",
  },
  {
    title: "Asset Library\nExtensions",
    body: "Expand your existing brand library without starting from scratch. Generate on-brand variations that slot directly into your established system.",
    poster: "/posters/asset-library-extensions.png",
    tone: "dark",
    alt: "Asset library example",
  },
];
---

<section class="relative bg-[linear-gradient(180deg,#4B308F_0%,#8052F5_100%)]">
  {/* MOBILE: vertical heading + horizontal touch carousel */}
  <div class="md:hidden py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center">
        <h2 class="text-4xl font-black leading-none tracking-tight text-white">
          Built For The Things You Make<span class="text-creo-purple-bright">.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-sm text-white/85">
          Whether you're running solo campaigns or managing a full production team,
          Creo fits the workflow.
        </p>
      </div>
      <div
        class="-mx-6 mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-6 pb-10 pt-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {features.map((f, i) => <BuiltForCard {...f} eager={i === 0} />)}
      </div>
    </div>
  </div>

  {/* DESKTOP: heading scrolls past normally, then cards pin for horizontal scroll */}
  <div class="hidden md:block">
    <div class="mx-auto max-w-7xl px-6 pt-24">
      <div class="text-center">
        <h2 class="mx-auto whitespace-nowrap text-5xl font-black leading-none tracking-tight text-white sm:text-6xl lg:text-[5.5rem]">
          Built For The Things You Make<span class="text-creo-purple-bright">.</span>
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-base text-white/85">
          Whether you're running solo campaigns or managing a full production team,
          Creo fits the workflow.
        </p>
      </div>
    </div>

    <div id="builtfor-pinned" class="mt-16">
      <div class="sticky top-0 flex h-[100dvh] items-center overflow-hidden">
        <div
          id="builtfor-track"
          class="flex gap-6 will-change-transform"
        >
          <div class="shrink-0 w-[calc(50vw-170px)]" aria-hidden="true"></div>
          {features.map((f, i) => <BuiltForCard {...f} eager={i === 0} />)}
          <div class="shrink-0 w-[calc(50vw-170px)]" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ---- Per-card play/pause toggle (only one video plays at a time) ----
  type CardCtl = {
    video: HTMLVideoElement;
    poster: HTMLImageElement | null;
    playIcon: SVGElement | null;
    pauseIcon: SVGElement | null;
  };
  const controllers: CardCtl[] = [];

  function setIcons(c: CardCtl, playing: boolean) {
    c.playIcon?.classList.toggle("hidden", playing);
    c.pauseIcon?.classList.toggle("hidden", !playing);
    // Fade video in when playing, fade out (revert to poster) when paused
    c.video.style.opacity = playing ? "1" : "0";
  }

  document.querySelectorAll<HTMLElement>("[data-builtfor-card]").forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>("[data-card-toggle]");
    const video = card.querySelector<HTMLVideoElement>("[data-card-video]");
    const poster = card.querySelector<HTMLImageElement>("[data-card-poster]");
    const playIcon = card.querySelector<SVGElement>("[data-icon-play]");
    const pauseIcon = card.querySelector<SVGElement>("[data-icon-pause]");
    if (!btn || !video) return;
    const ctl: CardCtl = { video, poster, playIcon, pauseIcon };
    controllers.push(ctl);

    btn.addEventListener("click", async () => {
      if (video.paused) {
        controllers.forEach((other) => {
          if (other.video !== video && !other.video.paused) {
            other.video.pause();
            other.video.currentTime = 0;
            setIcons(other, false);
          }
        });
        await video.play().catch(() => {});
        setIcons(ctl, true);
      } else {
        video.pause();
        setIcons(ctl, false);
      }
    });

    video.addEventListener("pause", () => setIcons(ctl, false));
    video.addEventListener("play", () => setIcons(ctl, true));
  });

  // ---- Reduced motion: skip pinned scroll + scale animation ----
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // ---- Desktop pinned horizontal scroll ----
  const pin = document.getElementById("builtfor-pinned");
  const track = document.getElementById("builtfor-track");
  const cards = document.querySelectorAll<HTMLElement>("[data-builtfor-card]");

  function isPinnedMode() {
    return (
      window.matchMedia("(min-width: 768px)").matches && !reducedMotion.matches
    );
  }

  function setPinHeight() {
    if (!pin || !track) return;
    if (isPinnedMode()) {
      const travel = Math.max(0, track.scrollWidth - window.innerWidth);
      pin.style.height = `${window.innerHeight + travel}px`;
    } else {
      pin.style.height = "";
      track.style.transform = "";
    }
  }

  function updateTransform() {
    if (!pin || !track) return;
    if (!isPinnedMode()) {
      track.style.transform = "";
      return;
    }
    const rect = pin.getBoundingClientRect();
    const totalScroll = pin.offsetHeight - window.innerHeight;
    if (totalScroll <= 0) return;
    const progress = Math.min(1, Math.max(0, -rect.top / totalScroll));
    const travel = track.scrollWidth - window.innerWidth;
    track.style.transform = `translate3d(${-progress * travel}px, 0, 0)`;
  }

  function updateScales() {
    if (!cards.length) return;
    if (reducedMotion.matches) {
      cards.forEach((c) => (c.style.transform = ""));
      return;
    }
    const cx = window.innerWidth / 2;
    const lastIdx = cards.length - 1;
    let closestIdx = -1;
    let closestDist = Infinity;
    cards.forEach((c, i) => {
      if (i === 0 || i === lastIdx) return;
      const r = c.getBoundingClientRect();
      const center = r.left + r.width / 2;
      const d = Math.abs(center - cx);
      if (d < closestDist) {
        closestDist = d;
        closestIdx = i;
      }
    });
    cards.forEach((c, i) => {
      c.style.transform = i === closestIdx ? "scale(1.06)" : "scale(1)";
    });
  }

  setPinHeight();
  updateTransform();
  updateScales();

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateTransform();
          updateScales();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true }
  );
  window.addEventListener("resize", () => {
    setPinHeight();
    updateTransform();
    updateScales();
  });
  reducedMotion.addEventListener("change", () => {
    setPinHeight();
    updateTransform();
    updateScales();
  });
</script>
