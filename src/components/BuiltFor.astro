---
import Logo from "./Logo.astro";
import BuiltForCard from "./BuiltForCard.astro";

type Tone = "lavender" | "white" | "dark";

const body =
  "Studio-quality visuals without the studio. Generate photorealistic, film-grade imagery and footage that elevates every piece of content you put out.";

const features: Array<{
  title: string;
  body: string;
  poster?: string;
  video?: string;
  tone: Tone;
  alt: string;
}> = [
  {
    title: "Character\nCreation",
    body,
    poster: "/posters/character-creation.png",
    tone: "dark",
    alt: "Character creation example",
  },
  {
    title: "Product\nIntegrations",
    body,
    poster: "/posters/product-integrations.png",
    tone: "white",
    alt: "Product integration example",
  },
  {
    title: "Cinematic\nContent",
    body,
    poster: "/posters/cinematic-content.png",
    video: "/videos/t-rex.mp4",
    tone: "dark",
    alt: "Cinematic content example",
  },
  {
    title: "User Generated\nContent",
    body,
    poster: "/posters/user-generated-content.png",
    video: "/videos/sophia-ugc.mp4",
    tone: "lavender",
    alt: "UGC example",
  },
  {
    title: "B-Roll\nCreation",
    body,
    poster: "/posters/b-roll.png",
    video: "/videos/b-roll.mp4",
    tone: "white",
    alt: "B-roll footage example",
  },
  {
    title: "Motion Graphics\n& Animation",
    body,
    poster: "/posters/motion-graphics.png",
    tone: "lavender",
    alt: "Motion graphics example",
  },
  {
    title: "Illustration\n& Infographics",
    body,
    poster: "/posters/illustration-infographics.png",
    tone: "dark",
    alt: "Illustration example",
  },
  {
    title: "Social Media\nTrends & Formats",
    body,
    poster: "/posters/social-media-trends.png",
    tone: "lavender",
    alt: "Social media trends example",
  },
  {
    title: "Asset Library\nExtensions",
    body,
    poster: "/posters/asset-library-extensions.png",
    tone: "white",
    alt: "Asset library example",
  },
];
---

<section class="relative overflow-hidden bg-creo-purple-band py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-center justify-between">
      <Logo variant="lavender" />
    </div>

    <div class="mt-20 text-center">
      <h2 class="mx-auto max-w-6xl text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-7xl md:text-[5.5rem]">
        Built For The Things You Make<span class="text-creo-purple-bright">.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-base text-white/85">
        Whether you're running solo campaigns or managing a full production team,
        Creo fits the workflow.
      </p>
    </div>

    <div class="relative mt-14">
      <div
        id="builtfor-track"
        class="flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {features.map((f) => <BuiltForCard {...f} />)}
      </div>

      <div class="mt-10 flex items-center justify-center gap-3">
        <button
          type="button"
          aria-label="Previous"
          data-builtfor-prev
          class="grid h-10 w-10 place-items-center rounded-md border border-white/40 text-white transition hover:bg-white/10"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button
          type="button"
          aria-label="Next"
          data-builtfor-next
          class="grid h-10 w-10 place-items-center rounded-md border border-white/40 text-white transition hover:bg-white/10"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("builtfor-track");
  if (track) {
    const card = track.querySelector("article") as HTMLElement | null;
    const step = card ? card.offsetWidth + 20 : 320;
    document.querySelector("[data-builtfor-prev]")?.addEventListener("click", () =>
      track.scrollBy({ left: -step, behavior: "smooth" })
    );
    document.querySelector("[data-builtfor-next]")?.addEventListener("click", () =>
      track.scrollBy({ left: step, behavior: "smooth" })
    );
  }

  // Per-card play/pause toggle
  document.querySelectorAll<HTMLElement>("[data-builtfor-card]").forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>("[data-card-toggle]");
    const video = card.querySelector<HTMLVideoElement>("[data-card-video]");
    const poster = card.querySelector<HTMLImageElement>("[data-card-poster]");
    const playIcon = card.querySelector<SVGElement>("[data-icon-play]");
    const pauseIcon = card.querySelector<SVGElement>("[data-icon-pause]");
    if (!btn || !video) return;
    btn.addEventListener("click", async () => {
      if (video.paused) {
        video.style.opacity = "1";
        if (poster) poster.style.opacity = "0";
        await video.play().catch(() => {});
        playIcon?.classList.add("hidden");
        pauseIcon?.classList.remove("hidden");
      } else {
        video.pause();
        video.style.opacity = "0";
        if (poster) poster.style.opacity = "1";
        playIcon?.classList.remove("hidden");
        pauseIcon?.classList.add("hidden");
      }
    });
  });

  // Scale-up when card centered in viewport
  const cards = document.querySelectorAll<HTMLElement>("[data-builtfor-card]");
  if (track && cards.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          (entry.target as HTMLElement).style.transform = entry.isIntersecting
            ? "scale(1.04)"
            : "scale(1)";
        });
      },
      { root: track, threshold: 0.85 }
    );
    cards.forEach((c) => observer.observe(c));
  }
</script>
