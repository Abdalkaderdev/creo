---
import BuiltForCard from "./BuiltForCard.astro";

type Tone = "lavender" | "white" | "dark" | "purple-gradient";

const features: Array<{
  title: string;
  body: string;
  poster?: string;
  video?: string;
  tone: Tone;
  alt: string;
  mediaPosition?: string;
  videoPosition?: string;
}> = [
  {
    title: "Character\nCreation",
    body: "Create original, consistent characters across styles and formats — from heroes and villains to influencers, mascots, and brand spokespeople.",
    poster: "/posters/character-creation.png",
    tone: "lavender",
    alt: "Character creation example",
    mediaPosition: "center top",
  },
  {
    title: "Product\nIntegrations",
    body: "Place your products into any scene, environment, or context. Photorealistic compositing at the speed of a prompt.",
    poster: "/posters/product-integrations.png",
    tone: "white",
    alt: "Product integration example",
    mediaPosition: "center top",
  },
  {
    title: "Cinematic\nVisuals",
    body: "Studio-quality visuals without the studio. Generate photorealistic, film-grade imagery and footage that elevates every piece of content you put out.",
    poster: "/posters/cinematic-content.png",
    video: "/videos/t-rex.mp4?v=3",
    tone: "dark",
    alt: "Cinematic content example",
    mediaPosition: "center top",
  },
  {
    title: "User Generated\nContent",
    body: "Produce authentic-feeling user-generated content at scale. The raw, relatable aesthetic — without the casting call.",
    poster: "/posters/user-generated-content.png",
    video: "/videos/sophia-ugc.mp4?v=3",
    tone: "lavender",
    alt: "UGC example",
    mediaPosition: "center top",
    videoPosition: "center 20%",
  },
  {
    title: "B-Roll\nCreation",
    body: "Generate cinematic supplemental footage that matches your hero content. Fill every cut without a second shoot day.",
    poster: "/posters/b-roll.png",
    video: "/videos/b-roll.mp4",
    tone: "white",
    alt: "B-roll footage example",
  },
  {
    title: "2D & 3D\nAnimation",
    body: "Enhance storytelling through dynamic animated content spanning hand-drawn, computer-generated, and experimental animation styles.",
    poster: "/posters/motion-graphics.png",
    video: "/videos/motion-graphics.mp4",
    tone: "dark",
    alt: "Animation example",
    mediaPosition: "center top",
  },
  {
    title: "Illustration\n& Infographics",
    body: "Original illustrated assets in any style — editorial, flat, painterly, technical. Consistent enough to build a visual system around.",
    poster: "/posters/illustration-infographics.png",
    tone: "lavender",
    alt: "Illustration example",
  },
  {
    title: "Social Media\nTrends & Formats",
    body: "Generate native-sized assets for every platform in one session. Reels, Stories, carousels, thumbnails — all from a single creative direction.",
    poster: "/posters/social-media-trends.png",
    tone: "white",
    alt: "Social media trends example",
    mediaPosition: "center top",
  },
  {
    title: "Asset Library\nExtensions",
    body: "Expand your existing brand library without starting from scratch. Generate on-brand variations that slot directly into your established system.",
    poster: "/posters/asset-library-extensions.png",
    tone: "dark",
    alt: "Asset library example",
  },
];
---

<section class="relative bg-[linear-gradient(180deg,#4B308F_0%,#8052F5_100%)]">
  {/* MOBILE: vertical heading + horizontal touch carousel */}
  <div class="md:hidden pt-20 pb-10">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center">
        <h2 class="text-4xl font-black leading-none tracking-tight text-white">
          Built For The Things<br />You Make<span class="text-creo-purple-bright">.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-md text-sm font-medium text-white">
          From branded asset creation to cinematic storytelling, Creo supports the full spectrum<br class="hidden sm:inline" />
          of modern creative production.
        </p>
      </div>
      <div
        class="-mx-6 mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pr-6 pb-20 pt-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [scroll-padding-left:1.5rem]"
      >
        <div class="shrink-0 w-6" aria-hidden="true"></div>
        {features.map((f, i) => <BuiltForCard {...f} eager={i === 0} />)}
        <div class="shrink-0 w-px" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  {/* DESKTOP: heading + horizontally-scrollable carousel with visible scrollbar */}
  <div class="hidden md:block pt-24 lg:pt-32 pb-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="text-center">
        <h2 class="text-5xl font-black leading-none tracking-tight text-white sm:text-6xl lg:text-[5.5rem]">
          Built For The Things<br />You Make<span class="text-creo-purple-bright">.</span>
        </h2>
        <p class="mx-auto mt-6 max-w-4xl text-lg font-medium text-white">
          From branded asset creation to cinematic storytelling, Creo supports the full spectrum<br class="hidden sm:inline" />
          of modern creative production.
        </p>
      </div>
    </div>

    <div
      data-builtfor-track
      class="mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto overflow-y-visible scroll-smooth pt-12 pb-24 [scroll-padding-left:1.5rem] [scrollbar-color:rgba(255,255,255,0.45)_rgba(255,255,255,0.12)] [scrollbar-width:thin] [&::-webkit-scrollbar]:h-2 [&::-webkit-scrollbar-track]:rounded-full [&::-webkit-scrollbar-track]:bg-white/10 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-white/40 hover:[&::-webkit-scrollbar-thumb]:bg-white/60"
    >
      <div class="shrink-0 w-6" aria-hidden="true"></div>
      {features.map((f, i) => <BuiltForCard {...f} eager={i === 0} />)}
      <div class="shrink-0 w-6" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  // Global mute state for all video cards. Default muted so browsers permit autoplay;
  // the per-card mute toggle flips it for everyone.
  let globalMuted = true;

  function syncMuteToggleUI() {
    document.querySelectorAll<HTMLElement>("[data-card-mute-toggle]").forEach((btn) => {
      btn.dataset.muted = globalMuted ? "true" : "false";
      const mutedIcon = btn.querySelector<HTMLElement>('[data-icon="muted"]');
      const unmutedIcon = btn.querySelector<HTMLElement>('[data-icon="unmuted"]');
      mutedIcon?.classList.toggle("hidden", !globalMuted);
      unmutedIcon?.classList.toggle("hidden", globalMuted);
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-card-mute-toggle]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      globalMuted = !globalMuted;
      syncMuteToggleUI();
      document.querySelectorAll<HTMLVideoElement>("[data-card-video]").forEach((v) => {
        v.muted = globalMuted;
      });
    });
  });

  type CardCtl = { video: HTMLVideoElement };
  const controllers: CardCtl[] = [];

  // Touch devices synthesize mouseenter on tap, which raced with click and made the
  // first tap play-then-stop. Only bind hover handlers when the device actually hovers.
  const supportsHover = window.matchMedia("(hover: hover)").matches;

  document.querySelectorAll<HTMLElement>("[data-builtfor-card]").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("[data-card-video]");
    if (!video) return;
    const overlay = card.querySelector<HTMLElement>("[data-card-play-overlay]");
    controllers.push({ video });

    const hideOverlay = () => { if (overlay) overlay.style.opacity = "0"; };
    const showOverlay = () => { if (overlay) overlay.style.opacity = "1"; };

    const startPlay = async () => {
      controllers.forEach((other) => {
        if (other.video !== video && !other.video.paused) {
          other.video.pause();
          other.video.currentTime = 0;
          other.video.style.opacity = "0";
          const otherOverlay = other.video.parentElement?.querySelector<HTMLElement>("[data-card-play-overlay]");
          if (otherOverlay) otherOverlay.style.opacity = "1";
        }
      });
      video.muted = globalMuted;
      video.volume = 1;
      try { await video.play(); } catch {}
      video.style.opacity = "1";
      hideOverlay();
    };
    const stopPlay = () => {
      video.pause();
      video.currentTime = 0;
      video.style.opacity = "0";
      showOverlay();
    };

    if (supportsHover) {
      card.addEventListener("mouseenter", startPlay);
      card.addEventListener("mouseleave", stopPlay);
      card.addEventListener("focusin", startPlay);
      card.addEventListener("focusout", stopPlay);
    }
    card.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-card-mute-toggle]")) return;
      if (video.paused) startPlay(); else stopPlay();
    });
  });

  syncMuteToggleUI();
</script>
