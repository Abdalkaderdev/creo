---
type Tone = "lavender" | "white" | "dark" | "purple-gradient";

interface Props {
  title: string;
  body: string;
  poster?: string;
  video?: string;
  tone: Tone;
  alt?: string;
  eager?: boolean;
}
const { title, body, poster, video, tone, alt = "", eager = false } = Astro.props;

const toneClass: Record<Tone, string> = {
  lavender: "bg-creo-card-lavender text-white",
  white: "bg-white text-creo-purple shadow-[0_30px_60px_-20px_rgba(0,0,0,0.45)]",
  dark: "bg-creo-card-dark text-white",
  "purple-gradient": "bg-[linear-gradient(180deg,#1E1E1E_0%,#4B308F_100%)] text-white",
};

const titleClass: Record<Tone, string> = {
  lavender: "text-white",
  white: "text-creo-purple",
  dark: "text-white",
  "purple-gradient": "text-white",
};

const bodyClass: Record<Tone, string> = {
  lavender: "text-white/85",
  white: "text-creo-purple",
  dark: "text-white/75",
  "purple-gradient": "text-white/85",
};
---

<article
  class:list={[
    "snap-start shrink-0 w-[280px] sm:w-[340px] h-[60vh] max-h-[560px] sm:h-[78vh] sm:max-h-[640px] rounded-3xl overflow-hidden flex flex-col transition-transform duration-300 will-change-transform hover:scale-[1.04]",
    toneClass[tone],
  ]}
  data-builtfor-card
>
  <div class="relative flex-1 min-h-0 bg-black">
    {poster && (
      <img
        src={poster}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
        data-card-poster
      />
    )}
    {video && (
      <video
        src={video}
        poster={poster}
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300"
        loop
        playsinline
        preload="metadata"
        data-card-video
      ></video>
    )}
  </div>
  <div class="shrink-0 p-6">
    <h3 class:list={["whitespace-pre-line text-xl font-bold leading-tight", titleClass[tone]]}>
      {title}
    </h3>
    <p class:list={["mt-3 text-sm leading-relaxed line-clamp-4", bodyClass[tone]]}>{body}</p>
  </div>
</article>
