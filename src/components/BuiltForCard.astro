---
type Tone = "lavender" | "white" | "dark" | "purple-gradient";

interface Props {
  title: string;
  body: string;
  poster?: string;
  video?: string;
  tone: Tone;
  alt?: string;
  eager?: boolean;
  mediaPosition?: string;
  videoPosition?: string;
}
const {
  title,
  body,
  poster,
  video,
  tone,
  alt = "",
  eager = false,
  mediaPosition = "center",
  videoPosition,
} = Astro.props;

const resolvedVideoPosition = videoPosition ?? mediaPosition;

const toneClass: Record<Tone, string> = {
  lavender: "bg-creo-card-lavender text-white",
  white: "bg-white text-creo-purple",
  dark: "bg-creo-card-dark text-white",
  "purple-gradient": "bg-[linear-gradient(180deg,#1E1E1E_0%,#4B308F_100%)] text-white",
};

const titleClass: Record<Tone, string> = {
  lavender: "text-white",
  white: "text-creo-purple",
  dark: "text-white",
  "purple-gradient": "text-white",
};

const bodyClass: Record<Tone, string> = {
  lavender: "text-white/85",
  white: "text-creo-purple",
  dark: "text-white/75",
  "purple-gradient": "text-white/85",
};
---

<article
  class:list={[
    "snap-start shrink-0 w-[280px] sm:w-[340px] h-[60vh] max-h-[560px] sm:h-[78vh] sm:max-h-[640px] rounded-3xl overflow-hidden flex flex-col transition-transform duration-300 will-change-transform hover:scale-[1.04] shadow-[0_30px_60px_-20px_rgba(0,0,0,0.45)]",
    toneClass[tone],
  ]}
  data-builtfor-card
>
  <div class="relative flex-1 min-h-0 bg-black">
    {poster && (
      <img
        src={poster}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        style={`object-position: ${mediaPosition}`}
        class="absolute inset-0 h-full w-full object-cover"
        data-card-poster
      />
    )}
    {video && (
      <video
        src={video}
        poster={poster}
        style={`object-position: ${resolvedVideoPosition}`}
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300"
        loop
        playsinline
        preload="metadata"
        data-card-video
      ></video>
    )}
    {video && (
      <div
        class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center transition-opacity duration-200 md:hidden"
        data-card-play-overlay
      >
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-black/55 ring-1 ring-white/30 backdrop-blur">
          <svg viewBox="0 0 24 24" fill="white" class="h-6 w-6 translate-x-[1px]" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </div>
    )}
    {video && (
      <button
        type="button"
        aria-label="Toggle audio"
        class="absolute bottom-3 right-3 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full bg-black/25 text-white backdrop-blur-sm transition hover:bg-black/45"
        data-card-mute-toggle
        data-muted="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true" data-icon="muted">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="22" y1="9" x2="16" y2="15"></line>
          <line x1="16" y1="9" x2="22" y2="15"></line>
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4 w-4" aria-hidden="true" data-icon="unmuted">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
      </button>
    )}
  </div>
  <div class="shrink-0 h-[220px] sm:h-[240px] p-6">
    <h3 class:list={["whitespace-pre-line text-xl font-bold leading-tight", titleClass[tone]]}>
      {title}
    </h3>
    <p class:list={["mt-3 text-sm leading-relaxed", bodyClass[tone]]}>{body}</p>
  </div>
</article>
