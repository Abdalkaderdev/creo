---
import IdCard from "./IdCard.astro";
---

<section class="relative overflow-hidden bg-[#1E1E1E] pb-28 pt-16 sm:pt-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-0 -z-0 h-[600px] w-[140%] -translate-x-1/2 select-none"
    style="background: radial-gradient(50% 60% at 50% 0%, rgba(128,82,245,0.55) 0%, rgba(30,30,30,0) 70%);"
  ></div>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="text-center">
      <h2 class="mx-auto text-4xl font-black leading-none tracking-tight sm:text-6xl md:text-[5.5rem] lg:text-[7rem]">
        Workflow Intelligence<span class="text-creo-purple-bright">.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-base font-medium text-white sm:mt-8 sm:text-lg">
        Creo is designed to remove friction and flatten the learning curve of AI-powered<br class="hidden sm:inline" />
        production, so you can stay focused on bringing ideas to life.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3 md:gap-8" data-id-grid>
      <IdCard icon="lucide:layout-template" title="Image Presets" body="Built-in prompt templates that give you a strong starting point for diverse creative use cases." />
      <IdCard icon="lucide:bot" title="AI Assistant" body="Troubleshoot unclear prompts, explore new approaches and clarify your intent for more accurate results." />
      <IdCard icon="lucide:wand-sparkles" title="Prompt Enhancer" body="Elevate simple prompts with refined language, added nuance, and richer detail — improving clarity and overall output quality." />
      <IdCard icon="lucide:blocks" title="Prompt Builder" body="Construct detailed prompts using default suggestions or add custom inputs for each variable within the prompt structure." />
      <IdCard icon="lucide:history" title="Prompt History" body="Revisit, reuse, or iterate your previous prompts with a prompt history connected to every image you create." />
      <IdCard icon="lucide:sliders-horizontal" title="Input Settings" body="Add reference images, guide cinematography, and fine-tune inputs for greater consistency and clarity." />
    </div>
  </div>
</section>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = document.querySelectorAll<HTMLElement>("[data-id-grid] > *");
  if (!reduced && cards.length) {
    cards.forEach((c) => {
      c.style.opacity = "0";
      c.style.transform = "translateY(24px)";
      c.style.transition = "opacity 600ms ease-out, transform 600ms ease-out";
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e, i) => {
          if (e.isIntersecting) {
            const idx = Array.from(cards).indexOf(e.target as HTMLElement);
            setTimeout(() => {
              (e.target as HTMLElement).style.opacity = "1";
              (e.target as HTMLElement).style.transform = "translateY(0)";
            }, idx * 80);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
