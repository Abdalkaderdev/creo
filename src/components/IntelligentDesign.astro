---
import Logo from "./Logo.astro";
import IdCard from "./IdCard.astro";
---

<section class="relative overflow-hidden bg-[#1E1E1E] pb-28 pt-20">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-0 mx-auto h-[80%] w-[140%] max-w-none -translate-y-[20%] select-none"
    style="background: radial-gradient(50% 50% at 50% 50%, rgba(128, 82, 245, 0.7) 0%, rgba(30, 30, 30, 0.7) 100%);"
  ></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex items-center justify-between">
      <Logo variant="lavender" />
    </div>

    <div class="mt-12 sm:mt-16">
      <h2 class="text-4xl font-bold leading-[0.95] tracking-tight sm:text-6xl md:text-[5.5rem] lg:text-[7rem]">
        Intelligent Design<span class="text-creo-purple-bright">.</span>
      </h2>
      <p class="mt-6 max-w-2xl text-sm text-creo-muted sm:mt-8 sm:text-base">
        Creo's intelligent workflow tools remove friction and flatten the
        learning curve, allowing you to generate ideas at the speed of your imagination.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3 md:gap-8">
      <IdCard icon="lucide:layout-template" title="Image Presets" body="Built-in prompt templates that give you a strong starting point for diverse creative use cases." />
      <IdCard icon="lucide:bot" title="AI Assistant" body="Troubleshoot unclear prompts, explore new approaches and clarify your intent for more accurate results." />
      <IdCard icon="lucide:wand-sparkles" title="Prompt Enhancer" body="Elevate simple prompts with refined language, added nuance, and richer detail — improving clarity and overall output quality." />
      <IdCard icon="lucide:blocks" title="Prompt Builder" body="Construct detailed prompts using default suggestions or add custom inputs for each variable within the prompt structure." />
      <IdCard icon="lucide:history" title="Prompt History" body="Revisit, reuse, or iterate your previous prompts with a prompt history connected to every image you create." />
      <IdCard icon="lucide:sliders-horizontal" title="Input Settings" body="Control your outputs with precision — add reference images, set aspect ratios, and fine-tune results for consistency and clarity." />
    </div>
  </div>
</section>
