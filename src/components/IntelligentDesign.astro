---
import Logo from "./Logo.astro";
import IdCard from "./IdCard.astro";
---

<section class="relative overflow-hidden bg-creo-bg pb-28 pt-20">
  <img
    src="/glow-ellipse.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-0 mx-auto w-[120%] max-w-none -translate-y-[18%] select-none"
  />

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex items-center justify-between">
      <Logo variant="lavender" />
    </div>

    <div class="mt-16 text-center">
      <h2 class="text-6xl font-bold leading-[0.95] tracking-tight sm:text-7xl md:text-[7rem]">
        Intelligent Design<span class="text-creo-purple-bright">.</span>
      </h2>
      <p class="mx-auto mt-8 max-w-2xl text-base text-creo-muted">
        Creo's intelligent workflow tools remove friction and flatten the
        learning curve, allowing you to generate ideas at the speed of your imagination.
      </p>
    </div>

    <div class="relative mx-auto mt-20 grid max-w-5xl items-center gap-6 md:grid-cols-3 md:gap-8">
      <div class="md:col-span-3 flex justify-center">
        <IdCard icon="robot" title="AI Assistant" body="Troubleshoot unclear prompts, explore new approaches and clarify your intent for more accurate results." />
      </div>

      <div class="flex flex-col gap-6 md:gap-8">
        <IdCard icon="preset" title="Image Presets" body="Built-in prompt templates that give you a strong starting point for diverse creative use cases." />
        <IdCard icon="blocks" title="Prompt Builder" body="Construct detailed prompts using default suggestions or add custom inputs for each variable within the prompt structure." />
      </div>

      <div class="hidden md:flex items-center justify-center">
        <div class="relative h-[460px] w-[460px]">
          <img
            src="/chip.png"
            alt=""
            aria-hidden="true"
            class="relative z-10 h-full w-full object-contain"
          />
        </div>
      </div>

      <div class="flex flex-col gap-6 md:gap-8">
        <IdCard icon="sparkles" title="Prompt Enhancer" body="Elevate simple prompts with refined language, added nuance, and richer detail — improving clarity and overall output quality." />
        <IdCard icon="sliders" title="Input Settings" body="Control your outputs with precision — add reference images, set aspect ratios, and fine-tune results for consistency and clarity." />
      </div>

      <div class="md:col-span-3 flex justify-center">
        <IdCard icon="history" title="Prompt History" body="Revisit, reuse, or iterate your previous prompts with a prompt history connected to every image you create." />
      </div>
    </div>
  </div>
</section>
