---
interface Props {
  icon: string;
  title: string;
  body: string;
}
const { icon, title, body } = Astro.props;

const s =
  'stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"';
const w = 'width="16" height="16" viewBox="0 0 24 24"';

const icons: Record<string, string> = {
  robot: `<svg ${w}><rect ${s} x="4" y="7" width="16" height="12" rx="2"/><path ${s} d="M12 3v4"/><circle ${s} cx="9" cy="13" r="1"/><circle ${s} cx="15" cy="13" r="1"/></svg>`,
  preset: `<svg ${w}><rect ${s} x="3" y="3" width="7" height="7" rx="1.5"/><rect ${s} x="14" y="3" width="7" height="7" rx="1.5"/><rect ${s} x="3" y="14" width="7" height="7" rx="1.5"/></svg>`,
  sparkles: `<svg ${w}><path ${s} d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6Z"/><path ${s} d="M19 16l.7 1.8L21.5 18.5l-1.8.7L19 21l-.7-1.8L16.5 18.5l1.8-.7Z"/></svg>`,
  blocks: `<svg ${w}><rect ${s} x="3" y="3" width="8" height="8" rx="1.5"/><rect ${s} x="13" y="3" width="8" height="8" rx="1.5"/><rect ${s} x="8" y="13" width="8" height="8" rx="1.5"/></svg>`,
  sliders: `<svg ${w}><path ${s} d="M4 7h10M18 7h2"/><circle ${s} cx="16" cy="7" r="2"/><path ${s} d="M4 17h4M12 17h8"/><circle ${s} cx="10" cy="17" r="2"/></svg>`,
  history: `<svg ${w}><path ${s} d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path ${s} d="M3 3v5h5"/><path ${s} d="M12 8v4l3 2"/></svg>`,
};
---

<article class="w-full max-w-[320px] rounded-2xl bg-gradient-to-b from-creo-purple-bright to-creo-purple p-6 text-white shadow-[0_24px_60px_-20px_rgba(124,92,255,0.6)] ring-1 ring-white/10">
  <div class="flex items-center gap-3">
    <span class="grid h-8 w-8 place-items-center rounded-lg bg-white/15 text-white" aria-hidden="true" set:html={icons[icon] ?? ""} />
    <h3 class="text-base font-semibold">{title}</h3>
  </div>
  <p class="mt-4 text-sm leading-relaxed text-white/90">{body}</p>
</article>
